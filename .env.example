# AI provider. Nothing is required: with no keys the app uses Pollinations' free,
# keyless gateway (open-weights GPT-OSS 20B), so it runs on real LLM calls at zero cost.

# Optional: any OpenAI-compatible endpoint instead (e.g. Gemini, Groq or OpenRouter free tiers)
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_API_KEY=
# LLM_MODEL=gemini-2.5-flash

# Optional: Claude (takes priority if set)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# Storage. Leave empty locally (uses .data/db.json).
# On Vercel, add Upstash Redis (free tier) from the Marketplace; it sets these for you.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
